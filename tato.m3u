import android.content.Context;
import android.content.SharedPreferences;
import android.database.Cursor;
import android.database.sqlite.SQLiteDatabase;
import android.database.sqlite.SQLiteStatement;
import android.net.Uri;
import android.util.JsonReader;
import android.util.JsonToken;
import java.io.*;
import java.net.*;
import java.util.*;

/** Read-only metadata for streams already present in the user's imported playlist. */
public final class IptvMetadata {
    private static final long INTERVAL=12L*60L*60L*1000L;
    private static final java.util.concurrent.atomic.AtomicBoolean BUSY=
        new java.util.concurrent.atomic.AtomicBoolean(false);
    private IptvMetadata(){}
    public static void refresh(Context ctx){
        SharedPreferences prefs=ctx.getSharedPreferences("iptv_metadata",Context.MODE_PRIVATE);
        long now=System.currentTimeMillis();
        long last=prefs.getLong("success",0),attempt=prefs.getLong("attempt",0);
        if(now-last<INTERVAL || now-attempt<30L*60L*1000L || !BUSY.compareAndSet(false,true))return;
        prefs.edit().putLong("attempt",now).apply();
        try(IptvStore store=new IptvStore(ctx);IptvLibrary library=new IptvLibrary(ctx)){
            library.ensureIndex();
            Uri source=null;
            HashMap<String,Long> movieIds=new HashMap<>();
            try(Cursor c=store.getReadableDatabase().rawQuery(
                "SELECT id,url FROM entries WHERE kind='Film' AND adult=0",null)){
                while(c.moveToNext()){
                    Uri u=Uri.parse(c.getString(1));
                    List<String> p=u.getPathSegments();
                    if(p.size()!=4 || !"movie".equals(p.get(0)) ||
                       !p.get(3).matches("[0-9]+\\.[a-zA-Z0-9]+"))continue;
                    if(source==null)source=u;
                    List<String> first=source.getPathSegments();
                    if(!Objects.equals(source.getScheme(),u.getScheme()) ||
                       !Objects.equals(source.getEncodedAuthority(),u.getEncodedAuthority()) ||
                       !first.get(1).equals(p.get(1)) || !first.get(2).equals(p.get(2)))continue;
                    String id=p.get(3).substring(0,p.get(3).indexOf('.'));
                    // Duplicate stream IDs do not get assigned to an arbitrary playlist row.
                    if(movieIds.containsKey(id))movieIds.put(id,-1L);
                    else movieIds.put(id,c.getLong(0));
                }
            }
            if(source==null)return;
            HashSet<String> shows=new HashSet<>();
            try(Cursor c=library.getReadableDatabase().rawQuery("SELECT DISTINCT series_key FROM series_index",null)){
                while(c.moveToNext())shows.add(c.getString(0));
            }
            int movies=read(ctx,library,source,"get_vod_streams",movieIds,shows,false);
            int series=read(ctx,library,source,"get_series",movieIds,shows,true);
            prefs.edit().putLong("success",System.currentTimeMillis())
                .putInt("movies",movies).putInt("series",series).apply();
        }catch(Exception e){
            // Never log a URL or provider credentials; a failed request keeps the previous cache.
            android.util.Log.w("FuoconeroIPTV","Provider metadata unavailable: "+e.getClass().getSimpleName());
        }finally{BUSY.set(false);}
    }
    private static int read(Context ctx,IptvLibrary library,Uri source,String action,
                            Map<String,Long> movieIds,Set<String> shows,boolean series)throws Exception{
        List<String> path=source.getPathSegments();
        Uri endpoint=new Uri.Builder().scheme(source.getScheme()).encodedAuthority(source.getEncodedAuthority())
            .path("/player_api.php").appendQueryParameter("username",path.get(1))
            .appendQueryParameter("password",path.get(2)).appendQueryParameter("action",action).build();
        HttpURLConnection connection=(HttpURLConnection)new URL(endpoint.toString()).openConnection();
        connection.setConnectTimeout(5000);connection.setReadTimeout(20000);
        connection.setInstanceFollowRedirects(false);
        connection.setRequestProperty("User-Agent","FuoconeroIPTV/0.5.3");
        SQLiteDatabase db=library.getWritableDatabase();
        try{
            if(connection.getResponseCode()!=200)throw new IOException("Metadata HTTP");
            if(connection.getContentLengthLong()>32L*1024L*1024L)throw new IOException("Metadata too large");
            InputStream limited=new FilterInputStream(connection.getInputStream()){
                long count=0;
                @Override public int read(byte[] b,int off,int len)throws IOException{
                    int n=super.read(b,off,len);
                    if(n>0 && (count+=n)>32L*1024L*1024L)throw new IOException("Metadata too large");
                    return n;
                }
                @Override public int read()throws IOException{
                    int n=super.read();
                    if(n>=0 && ++count>32L*1024L*1024L)throw new IOException("Metadata too large");
                    return n;
                }
            };
            int matched=0;long future=System.currentTimeMillis()+24L*60L*60L*1000L;
            db.beginTransactionNonExclusive();
            try(JsonReader reader=new JsonReader(new InputStreamReader(limited,"UTF-8"));
                SQLiteStatement put=db.compileStatement(series?
                    "INSERT OR REPLACE INTO source_series(series_key,updated_at,artwork) VALUES(?,?,?)":
                    "INSERT OR REPLACE INTO source_movies(media_id,added_at,artwork) VALUES(?,?,?)")){
                reader.beginArray();
                int rows=0;
                while(reader.hasNext()){
                    if(++rows>200000)throw new IOException("Metadata item limit");
                    String id="",name="",date="",image="";
                    reader.beginObject();
                    while(reader.hasNext()){
                        String key=reader.nextName();
                        boolean wanted=key.equals(series?"last_modified":"added") ||
                            key.equals(series?"cover":"stream_icon") || key.equals("name") || key.equals("stream_id");
                        if(!wanted || reader.peek()==JsonToken.NULL ||
                           !(reader.peek()==JsonToken.STRING || reader.peek()==JsonToken.NUMBER)){
                            reader.skipValue();continue;
                        }
                        String value=reader.nextString();
                        if(key.equals("name"))name=value;
                        else if(key.equals("stream_id"))id=value;
                        else if(key.equals(series?"cover":"stream_icon"))image=value;
                        else date=value;
                    }
                    reader.endObject();
                    if(!date.matches("[0-9]{9,13}"))continue;
                    long time=Long.parseLong(date);if(time<100000000000L)time*=1000L;
                    if(time<946684800000L || time>future)continue;
                    if(image.length()>2048 || !(image.startsWith("http://")||image.startsWith("https://")))image="";
                    put.clearBindings();
                    if(series){
                        String key=name.trim().replaceAll("\\s+"," ").toLowerCase(Locale.ROOT);
                        if(!shows.contains(key))continue;
                        put.bindString(1,key);
                    }else{
                        Long media=movieIds.get(id);if(media==null || media<0)continue;
                        put.bindLong(1,media);
                    }
                    put.bindLong(2,time);put.bindString(3,image);put.executeInsert();matched++;
                }
                reader.endArray();db.setTransactionSuccessful();
            }finally{db.endTransaction();}
            ctx.getSharedPreferences("iptv_metadata",Context.MODE_PRIVATE).edit()
                .putInt(series?"series":"movies",matched).apply();
            return matched;
        }finally{connection.disconnect();}
    }
}package com.fuoconero.tvbridge;

import android.content.Context;
import android.graphics.*;
import android.net.Uri;
import android.util.Log;
import java.io.*;
import java.net.*;
import java.util.*;
import java.util.regex.*;

/** Read artwork for the small home preview selection, without importing the catalog again. */
public final class IptvArtwork {
    private final HashMap<Long,String> images=new HashMap<>();
    private static final Pattern LOGO=Pattern.compile("(?:^|\\s)tvg-logo=\"([^\"]*)\"");
    public IptvArtwork(Context ctx,IptvStore store){
        HashMap<String,ArrayList<Long>> wanted=new HashMap<>();
        try{
            for(String category:IptvStore.PUBLIC_GROUPS){
                if(category.startsWith("Adulti"))continue;
                ArrayList<IptvStore.Media> items=new ArrayList<>();
                if(category.equals("Serie")||category.equals("Ultime serie")){
                    try(IptvLibrary lib=new IptvLibrary(ctx)){
                        for(IptvLibrary.Show show:lib.shows("",0,12,category.equals("Ultime serie"))){
                            IptvStore.Media media=store.find(show.newestId);
                            if(media!=null)items.add(media);
                        }
                    }
                }else if(category.equals("Ultimi film")){
                    try(IptvLibrary lib=new IptvLibrary(ctx)){items=lib.newestFilms(0,12);}
                }else if(category.equals("Continua")){
                    try(IptvLibrary lib=new IptvLibrary(ctx)){
                        for(IptvLibrary.Recent recent:lib.recentlyOpened(12))items.add(recent.media);
                    }
                }else items=store.list(category,"",0,12);
                try(IptvLibrary lib=new IptvLibrary(ctx)){
                    for(IptvStore.Media media:items){
                        String image=lib.artwork(media.id);
                        if(!media.adult && image!=null && !image.isEmpty())images.put(media.id,image);
                    }
                }
                for(IptvStore.Media media:items){
                    if(media.adult||media.url==null)continue;
                    ArrayList<Long> ids=wanted.get(media.url);
                    if(ids==null){ids=new ArrayList<>();wanted.put(media.url,ids);}
                    ids.add(media.id);
                }
            }
            android.content.SharedPreferences p=ctx.getSharedPreferences(IptvStore.PREFS,Context.MODE_PRIVATE);
            String path=p.getString("source_path",""),uri=p.getString("source_uri","");
            InputStream input=!path.isEmpty()?new FileInputStream(path):
                !uri.isEmpty()?ctx.getContentResolver().openInputStream(Uri.parse(uri)):null;
            if(input==null)return;
            try(BufferedReader reader=new BufferedReader(new InputStreamReader(input,"UTF-8"),65536)){
                String line,logo="";
                while((line=reader.readLine())!=null&&!wanted.isEmpty()){
                    if(line.startsWith("#EXTINF:")){
                        Matcher m=LOGO.matcher(line);logo=m.find()?m.group(1).trim():"";
                    }else if(!line.startsWith("#")){
                        ArrayList<Long> ids=wanted.remove(line.trim());
                        if(ids!=null&&(logo.startsWith("https://")||logo.startsWith("http://"))&&logo.length()<2048)
                            for(Long id:ids)if(!images.containsKey(id))images.put(id,logo);
                        logo="";
                    }
                }
            }
            Log.i("FuoconeroIPTV","Immagini playlist disponibili per "+images.size()+" anteprime");
        }catch(Exception e){Log.w("FuoconeroIPTV","Lettura immagini: "+e.getClass().getSimpleName());}
    }
    public boolean cover(Context ctx,IptvStore.Media media,File target){
        if(media.adult)return false;
        File marker=new File(target.getParentFile(),"art_"+media.id+".ok");
        if(marker.isFile()&&target.isFile())return true;
        String url=images.get(media.id);
        if(url==null)return false;
        HttpURLConnection connection=null;
        Bitmap decoded=null,card=null;
        try{
            connection=(HttpURLConnection)new URL(url).openConnection();
            connection.setConnectTimeout(3000);connection.setReadTimeout(3000);
            connection.setRequestProperty("User-Agent","FuoconeroIPTV/0.5.3");
            if(connection.getResponseCode()!=200)throw new IOException("HTTP image");
            if(connection.getContentLengthLong()>2*1024*1024)throw new IOException("Image too large");
            ByteArrayOutputStream bytes=new ByteArrayOutputStream();
            try(InputStream in=connection.getInputStream()){
                byte[] buffer=new byte[8192];int n;
                while((n=in.read(buffer))!=-1){
                    if(bytes.size()+n>2*1024*1024)throw new IOException("Image too large");
                    bytes.write(buffer,0,n);
                }
            }
            byte[] data=bytes.toByteArray();
            BitmapFactory.Options options=new BitmapFactory.Options();options.inJustDecodeBounds=true;
            BitmapFactory.decodeByteArray(data,0,data.length,options);
            if(options.outWidth<=0||options.outHeight<=0)throw new IOException("Invalid image");
            options.inSampleSize=1;
            while(options.outWidth/options.inSampleSize>1200||options.outHeight/options.inSampleSize>1800)options.inSampleSize*=2;
            options.inJustDecodeBounds=false;
            decoded=BitmapFactory.decodeByteArray(data,0,data.length,options);
            if(decoded==null)throw new IOException("Invalid bitmap");
            card=Bitmap.createBitmap(360,540,Bitmap.Config.ARGB_8888);
            Canvas canvas=new Canvas(card);canvas.drawColor(0xff162033);
            boolean tv="TV".equals(media.kind);
            float maxW=tv?320:360,maxH=tv?330:540;
            float scale=Math.min(maxW/decoded.getWidth(),maxH/decoded.getHeight());
            float w=decoded.getWidth()*scale,h=decoded.getHeight()*scale;
            float top=tv?70+(330-h)/2:(540-h)/2;
            canvas.drawBitmap(decoded,null,new RectF((360-w)/2,top,(360+w)/2,top+h),new Paint(3));
            if(tv){
                Paint paint=new Paint(3);paint.setColor(Color.WHITE);paint.setTextSize(22);
                paint.setTypeface(Typeface.create("sans-serif",Typeface.BOLD));
                String title=media.title;
                canvas.drawText(title.length()>24?title.substring(0,24):title,18,470,paint);
                paint.setTextSize(16);paint.setColor(0xffff984c);
                canvas.drawText("FUOCONERO IPTV",18,510,paint);
            }
            File temporary=new File(target.getParentFile(),target.getName()+".tmp");
            try(FileOutputStream out=new FileOutputStream(temporary)){
                if(!card.compress(Bitmap.CompressFormat.PNG,90,out))throw new IOException("Encode image");
            }
            if(!temporary.renameTo(target))throw new IOException("Save image");
            try(FileOutputStream out=new FileOutputStream(marker)){out.write(1);}
            return true;
        }catch(Exception e){Log.w("FuoconeroIPTV","Immagine "+media.id+": "+e.getClass().getSimpleName());return false;}
        finally{if(connection!=null)connection.disconnect();if(decoded!=null)decoded.recycle();if(card!=null)card.recycle();}
    }
}package com.fuoconero.tvbridge;

import android.content.Context;
